    "html": "<!DOCTYPE html>\n<html lang=\"he\" dir=\"rtl\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>ברכת מזל טוב - אירוסין</title>\n  <style>\n    @import url('https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;700;900&family=Heebo:wght@400;600;800&display=swap');\n\n    body {\n      margin: 0;\n      padding: 0;\n      background-color: #e8e4dc;\n      font-family: 'Frank Ruhl Libre', 'Times New Roman', serif;\n    }\n\n    .wrapper {\n      width: 100%;\n      background-color: #e8e4dc;\n      padding: 40px 0;\n    }\n\n    /* Floating Card Container with Arched Top */\n    .email-container {\n      width: 600px;\n      margin: 0 auto;\n      background-color: #fbf8f3;\n      border-radius: 30px 30px 16px 16px;\n      box-shadow: 0 20px 40px rgba(0,0,0,0.08);\n      overflow: hidden;\n      font-family: 'Frank Ruhl Libre', 'Times New Roman', serif;\n    }\n\n    /* Distinct Burgundy Top Header Bar */\n    .top-bar {\n      font-family: 'Heebo', sans-serif;\n      background-color: #781c1c;\n      color: #ffffff;\n      font-size: 15px;\n      font-weight: 700;\n      padding: 14px;\n      text-align: center;\n      letter-spacing: 0.5px;\n    }\n\n    /* Button Container */\n    .btn-container {\n      background-color: #f2ebd9;\n      padding: 10px 0 16px 0;\n      text-align: center;\n    }\n\n    /* Sleek, Compact Two-Color Gradient Button */\n    .donate-btn {\n      font-family: 'Heebo', sans-serif;\n      font-size: 13px;\n      font-weight: 800;\n      color: #ffffff !important;\n      background: linear-gradient(135deg, #781c1c 0%, #a83232 100%);\n      border: 1px solid #d09050;\n      border-radius: 50px;\n      padding: 7px 20px;\n      text-decoration: none;\n      display: inline-block;\n      box-shadow: 0 3px 8px rgba(120, 28, 28, 0.2);\n      transition: all 0.3s ease;\n    }\n\n    /* Blank Background with Text Overlay */\n    .blank-bg-cell {\n      background-image: url('https://lh3.googleusercontent.com/d/1iVG8vCLdQaNEmUnh8rlDdqkZZejwjz1d');\n      background-position: top center;\n      background-size: 100% 100%;\n      background-repeat: no-repeat;\n      padding: 215px 35px 95px 35px;\n      text-align: center;\n      font-family: 'Frank Ruhl Libre', 'Times New Roman', serif;\n    }\n\n    /* Matching Burgundy Geometric Line Separator */\n    .dot-divider {\n      text-align: center;\n      color: #781c1c !important; /* Forced burgundy color */\n      font-size: 16px;\n      margin: 10px 0;\n      font-family: 'Frank Ruhl Libre', 'Times New Roman', serif;\n    }\n\n    /* Text Typography */\n    .recipient-title { font-family: 'Frank Ruhl Libre', serif; font-size: 16px; color: #666; margin-bottom: 2px; }\n    .recipient-name { font-family: 'Frank Ruhl Libre', serif; font-size: 26px; font-weight: 900; color: #111; margin-bottom: 2px; }\n    .recipient-subtitle { font-family: 'Frank Ruhl Libre', serif; font-size: 15px; font-weight: 700; color: #444; margin-bottom: 16px; }\n    .opening-text { font-family: 'Frank Ruhl Libre', serif; font-size: 15px; line-height: 1.6; color: #333; margin-bottom: 16px; }\n    .main-heading { font-family: 'Frank Ruhl Libre', serif; font-size: 30px; font-weight: 900; color: #781c1c; margin: 6px 0 0 0; }\n    .sub-heading { font-family: 'Frank Ruhl Libre', serif; font-size: 20px; font-weight: 700; color: #781c1c; margin-bottom: 14px; }\n    .text-highlight { font-family: 'Frank Ruhl Libre', serif; font-size: 17px; font-weight: 700; color: #222; margin-bottom: 18px; line-height: 1.5; }\n    .blessings { font-family: 'Frank Ruhl Libre', serif; font-size: 15px; line-height: 1.7; color: #222; margin-bottom: 20px; }\n    .blessings p { margin: 4px 0; }\n    .footer { font-family: 'Frank Ruhl Libre', serif; margin-top: 15px; font-size: 17px; font-weight: 700; color: #781c1c; border-top: 1px solid #e2d7c5; padding-top: 10px; }\n    .footer-sub { font-family: 'Frank Ruhl Libre', serif; font-size: 14px; font-weight: normal; color: #444; margin-top: 4px; }\n\n    /* Footer Toolbar Links */\n    .contact-footer {\n      background-color: #f2ebd9;\n      border-top: 1px solid #e3d9c3;\n      padding: 18px 10px;\n      text-align: center;\n      font-family: 'Heebo', sans-serif;\n    }\n\n    .icon-link {\n      color: #333333 !important;\n      text-decoration: none !important;\n      font-size: 15px;\n      font-weight: 700;\n      margin: 0 18px;\n      display: inline-block;\n      vertical-align: middle;\n    }\n\n    .icon-link span {\n      color: #333333 !important;\n    }\n\n    .icon-img {\n      width: 24px;\n      height: 24px;\n      vertical-align: middle;\n      margin-left: 8px;\n    }\n  </style>\n</head>\n<body>\n  <center class=\"wrapper\">\n    <table class=\"email-container\" width=\"600\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n      <tr>\n        <td>\n          <div class=\"top-bar\">ב\"ה | {{parsha}} | {{hebrew_month}} {{hebrew_year}}</div>\n        </td>\n      </tr>\n      <tr>\n        <td class=\"btn-container\">\n          <a href=\"#\" class=\"donate-btn\">להעמדת ייין לחץ כאן! ❤</a>\n        </td>\n      </tr>\n      <tr>\n        <td class=\"blank-bg-cell\" valign=\"top\">\n          <div>\n            <div class=\"recipient-title\">כבוד ידידנו היקר והנכבד</div>\n            <!-- System Variable: Recipient Name -->\n            <div class=\"recipient-name\">{{name}}</div>\n            {{hok}}\n            \n            <div class=\"dot-divider\">&#9670; &#9670; &#9670;</div>\n            \n            <div class=\"opening-text\">\n              ברחשי אחוה ושותפות, מבין כתלי בית חיינו נקודת לבבינו,<br>\n              הננו להביע ברכתנו הנאמנה\n            </div>\n            \n            <div class=\"main-heading\">בברכת מזל טוב</div>\n            <div class=\"sub-heading\">חמה ולבבית</div>\n            \n            <!-- System Variable: Occasion -->\n            <div class=\"text-highlight\">\n              {{occasion}}<br>\n              בשעה טובה ומוצלחת\n            </div>\n            \n            <div class=\"dot-divider\">&#9670; &#9670; &#9670;</div>\n            \n            <div class=\"blessings\">\n              <p>ברכת רבנו הק&#39; תלווהו ותעטרהו בשמחות לרוב במעוניך,</p>\n              <p>אושר ועושר, נחת דקדושה עם כל מילי דמיטב לאורך ימים ושנים טובות,</p>\n              <p>בשמחת הלב והרחבת הדעת ושלוות הנפש</p>\n              <p>ותזכה תמיד לעמוד לימין הקודש,לכל קדשי בית ויז&#39;ניץ.</p>\n            </div>\n            \n            <!-- Updated Signature Footer -->\n            <div class=\"footer\">\n              בברכת אחי&quot;ם<br>\n              <div class=\"footer-sub\">שאול לייב שרייבר ב\\ וועד להוצאת דא&quot;ח</div>\n            </div>\n          </div>\n        </td>\n      </tr>\n      <tr>\n        <td class=\"contact-footer\">\n          <!-- Email Link -->\n          <a href=\"mailto:info@example.com\" class=\"icon-link\">\n            <img src=\"https://lh3.googleusercontent.com/d/15xICrWDApGEH4Ph8jYvIWKfPkAJcg0T_\" alt=\"Email\" class=\"icon-img\">\n            <span>אימייל</span>\n          </a>\n          <!-- Call Link -->\n          <a href=\"tel:030000000\" class=\"icon-link\">\n            <img src=\"https://lh3.googleusercontent.com/d/19ag7IxtvSu75FiwatRl-ZEjlkfdgUwfL\" alt=\"Phone\" class=\"icon-img\">\n            <span>ליצור קשר</span>\n          </a>\n          <!-- Credit Card Link -->\n          <a href=\"#\" class=\"icon-link\">\n            <img src=\"https://lh3.googleusercontent.com/d/155jUSSxT3_0rTjAb2VGaoVl8wkMIoAqg\" alt=\"Donate\" class=\"icon-img\">\n            <span>נדרים ונדבות</span>\n          </a>\n        </td>\n      </tr>\n    </table>\n  </center>\n</body>\n</html>"
