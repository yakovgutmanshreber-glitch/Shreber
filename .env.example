# ---------------------------------------------------------------------------
# Database — PostgreSQL (Supabase)
# From Supabase → Project Settings → Database → Connection string.
#   DATABASE_URL = "Transaction pooler" (port 6543) + ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = "Direct connection"  (port 5432) — used by prisma db push / migrate
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# NextAuth / Auth.js
# Generate a secret with:  openssl rand -base64 32
# AUTH_URL / NEXTAUTH_URL must be your DEPLOYED URL in production.
# ---------------------------------------------------------------------------
AUTH_SECRET="change-me-to-a-random-32-byte-secret"
AUTH_URL="https://your-app.vercel.app"
NEXTAUTH_URL="https://your-app.vercel.app"

# Google OAuth (optional — password login works without these)
# Authorized redirect URI: https://your-app.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------------------
# Kesher payment API (kesherhk.info)
# ---------------------------------------------------------------------------
KESHER_API_USERNAME=""
KESHER_API_PASSWORD=""
KESHER_API_TOKEN=""       # Bearer token for the KesherAPI/* REST endpoints (optional)
KESHER_MOCK="false"       # "true" = no real charges (safe testing)

# Shared secret Kesher must include when calling our webhook
KESHER_WEBHOOK_SECRET="change-me-webhook-secret"

# ---------------------------------------------------------------------------
# Email (task reminders) — your OWN mailbox via SMTP.
# Gmail: host=smtp.gmail.com, port=465, secure=true, user=you@gmail.com,
#        pass = a 16-char *App Password* (Google Account → Security → 2-Step
#        Verification → App passwords). NOT your normal Gmail password.
# ---------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"           # "true" for port 465, "false" for 587
SMTP_USER="you@gmail.com"    # the account the mail is sent FROM
SMTP_PASS="your-app-password"
MAIL_FROM=""                 # optional; defaults to SMTP_USER
NOTIFY_EMAIL=""              # where reminders are sent TO; defaults to SMTP_USER

# Secret the external every-minute scheduler must include:
#   GET https://your-app.vercel.app/api/cron/tasks?secret=<this>
TASKS_CRON_SECRET="change-me-tasks-cron-secret"
